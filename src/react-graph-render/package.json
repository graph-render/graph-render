{
  "name": "@graph-render/react",
  "version": "1.7.3",
  "description": "Interactive React SVG graph canvas for graph-render.",
  "keywords": [
    "graph",
    "react",
    "svg",
    "visualization",
    "canvas"
  ],
  "homepage": "https://github.com/graph-render/graph-render#readme",
  "bugs": {
    "url": "https://github.com/graph-render/graph-render/issues"
  },
  "author": "graph-render maintainers",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/graph-render/graph-render.git",
    "directory": "src/react-graph-render"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && rm -f tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@graph-render/core": "1.6.3",
    "@graph-render/types": "1.8.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "react": ">=19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
